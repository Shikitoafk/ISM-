# Канонический адрес сайта — используется для metadataBase (Open Graph,
# ссылки на превью). Без него ссылки в OG-тегах будут указывать на localhost.
NEXT_PUBLIC_SITE_URL="https://ism-olympiad.example"

# Режим регистрации: "supabase" или "google_form"
NEXT_PUBLIC_REGISTRATION_MODE="supabase"

# Supabase — замените на реальные значения из Supabase Dashboard → Settings → API
# Без этого регистрация и site_settings не будут работать (локально и на Vercel).
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Google Forms (если NEXT_PUBLIC_REGISTRATION_MODE="google_form")
NEXT_PUBLIC_GOOGLE_FORM_URL="https://docs.google.com/forms/d/e/.../viewform"
